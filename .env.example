# Configurações do Banco de Dados PostgreSQL
# Exemplo: postgresql://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academia

# Chave secreta para geração e assinatura dos tokens JWT (use uma string segura e aleatória)
SECRET_KEY=sua_chave_secreta_super_segura_aqui
